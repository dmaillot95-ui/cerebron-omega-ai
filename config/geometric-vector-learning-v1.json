{
  "schema": "CEREBRON_GEOMETRIC_VECTOR_LEARNING_V2",
  "version": "2.0.0",
  "status": "ACTIVE_MEASUREMENT_CONTRACT_V2",
  "runtime_changed": false,
  "name": "GVL",
  "full_name": "GEOMETRIC VECTOR LEARNING",
  "purpose": "Make each validated learning cycle improve future cycles through a shared coaxial evidence axis while preserving distinct specialization vectors and suppressing redundant learning.",
  "definitions": {
    "coaxial_axis": "Shared invariants every AI must preserve.",
    "specialization_vector": "Interpretable vector describing the AI's distinct functional direction.",
    "novelty": "Distance from already-promoted lessons/vectors; high novelty means low redundancy.",
    "transfer_gain": "Measured quality improvement on a different task after a validated lesson.",
    "compound_gain": "Measured multiplication of validated transferable quality across cycles; never assumed from architecture alone."
  },
  "coaxial_axis": {
    "id": "CEREBRON_M_CORE",
    "invariants": [
      "REALITY_GT_COHERENCE",
      "EVIDENCE_GT_CONFIDENCE",
      "CLAIM_LE_EVIDENCE",
      "SPIRALIX_REQUIRED",
      "PROVENANCE_REQUIRED",
      "SHARED_LINEAGE_NE_INDEPENDENT_EVIDENCE",
      "SIMULATION_NE_TEST",
      "MEMORY_NE_TRAINING",
      "NO_DESTRUCTIVE_OVERWRITE",
      "TRANSFER_BEFORE_GENERALITY"
    ]
  },
  "vector_space": {
    "basis": [
      "coordination",
      "execution_selection",
      "memory_continuity",
      "formal_reasoning",
      "evidence_audit",
      "counterexample",
      "simulation",
      "science_modeling",
      "engineering_validation",
      "invention",
      "search_exploration",
      "causal_mechanism",
      "uncertainty",
      "integration_interfaces",
      "synthesis_compression",
      "human_dialogue",
      "metrology_benchmark",
      "problem_contract",
      "sensitivity_robustness",
      "temporal_dynamics",
      "representation_transform",
      "constraint_feasibility",
      "transfer_generalization",
      "information_gain",
      "statistics_aggregation",
      "optimization_efficiency",
      "tradeoff_pareto",
      "invariants_scaling",
      "rare_events",
      "hidden_variables",
      "dependency_correlation",
      "null_baseline"
    ],
    "dimension": 32,
    "metric": "COSINE_SIMILARITY",
    "redundancy": "R_ij=cos(S_i,S_j)",
    "novelty": "N_i=1-max_j(R_ij) against promoted comparable lessons",
    "complementarity": "K_ij=1-R_ij when both pass evidence/role gates",
    "note": "Authoritative vectors come from config/gvl-specialization-registry-v2.json; they are explicit functional control-plane vectors, not neural embeddings."
  },
  "learning_equations": {
    "local_quality_gain": "g_i=max(0,transfer_quality_after-transfer_quality_before)",
    "effective_gain": "e_i=g_i*novelty_i*evidence_weight_i*audit_pass_i",
    "collective_step": "Q_(t+1)=Q_t*(1+alpha*mean(e_i))",
    "observed_ratio": "r_t=Q_(t+1)/Q_t",
    "geometric_claim_gate": "Only call growth geometric-like after >=4 consecutive transfer cycles with r_t>1 on held-out tasks and no quality/evidence regression.",
    "redundancy_penalty": "effective_information=raw_information*(1-redundancy)",
    "quality_metric": "Q defined by config/gvl-growth-benchmark-v1.json",
    "comparability_rule": "Only frozen benchmark version and distinct held-out task families may contribute to geometric-like claim."
  },
  "lesson_pipeline": [
    "REAL_EXECUTION",
    "SPIRALIX_ENVELOPE",
    "LOCAL_ROLE_RESULT",
    "AUDIT_AND_COUNTER_AUDIT",
    "EXTRACT_INVARIANT_LESSON",
    "VECTORIZE_LESSON",
    "DEDUP_AGAINST_PROMOTED_MEMORY",
    "TRANSFER_TEST_ON_NEW_TASK",
    "MEASURE_GAIN_AND_NOVELTY",
    "PROMOTE_ONLY_IF_POSITIVE_EFFECTIVE_GAIN",
    "A6_VERSIONED_MEMORY",
    "PROPAGATE_INVARIANT_NOT_RAW_COPY"
  ],
  "propagation": {
    "principle": "One AI's validated lesson may improve other AIs through a compact invariant capsule without forcing all AIs to duplicate the same specialization.",
    "capsule_fields": [
      "lesson_id",
      "source_ai",
      "source_role",
      "problem_class",
      "invariant",
      "scope",
      "evidence_refs",
      "failure_modes",
      "specialization_vector",
      "novelty_score",
      "transfer_gain",
      "parent_sha",
      "rollback_pointer"
    ],
    "receiving_rule": "Receiver integrates the invariant into its coaxial axis or role contract only if relevant; it does not copy the source's full specialization."
  },
  "promotion_gates": {
    "minimum_evidence_level": "E2",
    "require_transfer_test": true,
    "require_counter_audit": true,
    "require_positive_effective_gain": true,
    "novelty_floor": 0.15,
    "max_redundancy_for_new_specialist": 0.85,
    "duplicate_behavior": "MERGE_OR_REFERENCE_EXISTING_LESSON_INSTEAD_OF_COPYING"
  },
  "scale_interlock": {
    "policy": "config/quality-first-scale-policy-v1.json",
    "rule": "Increasing 5->10->20 is forbidden as a substitute for low novelty or failed transfer.",
    "burst_selection": "Prefer candidates maximizing expected information gain and vector complementarity subject to evidence and execution-route gates."
  },
