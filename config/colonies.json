{
  "schema": "cerebron-colony-registry-v1",
  "version": "1.0",
  "date": "2026-09-20",
  "privacy": "PRIVATE_BY_DEFAULT",
  "rules": [
    "REALITY > COHERENCE",
    "EVIDENCE > CONFIDENCE",
    "CLAIM <= EVIDENCE",
    "VERIFY BEFORE COMMIT",
    "ABLATION BEFORE ADDITION",
    "TRANSFER BEFORE GENERALITY",
    "CONSENSUS != PROOF"
  ],
  "activation": {
    "default_status": "INACTIVE",
    "allowed_status": [
      "ACTIVE",
      "INACTIVE",
      "UNAVAILABLE",
      "EXPERIMENTAL",
      "VALIDATED"
    ],
    "rule": "A colony may execute only when at least one real model/agent/resource is assigned and benchmarked. Never simulate execution."
  },
  "cell_template": [
    "CHIEF",
    "ROUTER",
    "SPECIALISTS",
    "AUDITOR",
    "COUNTER_AUDITOR",
    "REPRODUCER",
    "SYNTHESIZER"
  ],
