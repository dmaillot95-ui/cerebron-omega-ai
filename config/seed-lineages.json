    }
  ],
  "selection_policy": {
    "rule": "NO_BINDING_BY_POPULARITY",
    "required_before_binding": [
      "PIN_IMMUTABLE_REVISION",
      "LICENSE_CHECK",
      "BASELINE",
      "COLD_BENCHMARK",
      "AUDIT",
      "RED_TEAM",
      "ABLATION",
      "TRANSFER"
    ],
    "first_target": "C01-SIGMA",
    "diversity_rule": "Prefer genuinely different model families/lineages when independence matters."
  }
}
