{
  "schema": "cerebron-private-memory-route-v1",
  "version": "1.0",
  "status": "HF_PRIVATE_SCOPED_VERIFIED_GLOBAL_AI_ROLLOUT_GATED",
  "authority": "AFAH",
  "objective": "Keep private colony learning and parametric artifacts outside public GitHub while retaining non-sensitive routing metadata.",
  "routes": {
    "public_control_plane": {
      "store": "GitHub",
      "allowed": [
        "opaque memory_id",
        "colony_id",
        "generation",
        "non-sensitive status",
        "content digest",
        "provider object ID if non-sensitive",
        "benchmark/audit status"
      ],
      "forbidden": [
        "private payload",
        "training examples",
        "private prompts/context",
        "tokens",
        "credentials",
        "private weights/adapters"
      ]
    },
    "private_data_plane": {
      "preferred_store": "Hugging Face private repository",
      "auth": "REQUIRED",
      "contents": [
        "private validated memory payloads",
        "private datasets when approved",
        "LoRA/adapters",
        "derived weights"
      ],
      "availability": "VERIFIED_SCOPED",
      "repo_id": "cerebron-omega/cerebron-private-memory",
      "verification_receipts": [
        "receipts/colonies/wave01-hf-memory-gate.json",
        "receipts/p03/hf-memory-health.json",
        "receipts/p03/unified-memory-recall-v2.json"
      ],
      "global_ai_rollout": "REQUIRES_PER_AI_OR_REPRESENTATIVE_FAMILY_WRITE_READ_SHA_CANARY"
    }
  },
  "envelope": {
    "public_pointer_fields": [
      "memory_id",
      "colony_id",
      "generation",
      "payload_sha256",
      "provider",
      "private_object_id",
      "revision",
      "validation_status"
    ],
    "private_payload_fields": [
      "content",
      "training_examples",
      "private_context",
      "adapter_or_weight_artifact"
    ]
  },
  "protocol": [
    "CLASSIFY",
    "REJECT_SECRET",
    "HASH_PRIVATE_PAYLOAD",
    "DEDUP",
    "WRITE_NEW_VERSION_PRIVATE_STORE",
    "READ_BACK_PRIVATE_STORE",
    "VERIFY_DIGEST",
    "WRITE_PUBLIC_OPAQUE_POINTER",
    "INDEX_F66",
    "REGISTER_F74_POINTER",
    "RECALL_TEST",
    "CHECKPOINT_PARENT_AND_ROLLBACK"
  ],
  "failure_rule": "If authenticated private write/read is unavailable for a target AI/agent, mark HF_PRIVATE_UNAVAILABLE for that scope, retain versioned local/ephemeral state as permitted, and never publish private payload.",
  "security": "A public pointer must not reveal sensitive content through names, descriptions, metadata, URLs, or embedded parameters.",
  "next_gate": "EXPAND_AUTHENTICATED_HF_WRITE_READ_SHA_CANARIES_TO_GREEK_AND_NATIVE_AI_FAMILIES",
  "successor_rule": "A successor AI must read the latest verified checkpoint and opaque pointer set before creating a new version; never overwrite the only prior version."
}
