    "cross_architecture_weights": "DENY",
    "negative_transfer": "ROLLBACK"
  },
  "forum_required": true,
  "agora_required": true,
  "runtime_changed": false,
  "spiralix_transport": {
    "status": "MANDATORY",
    "language": "SPIRALIX-OMEGA",
    "mode": "CEREBRON-M",
    "universal_bus": "config/spiralix-universal-bus-v1.json",
    "input_envelope": "CEREBRON_SPIRALIX_ENVELOPE_V1",
    "output_envelope": "CEREBRON_SPIRALIX_ENVELOPE_V1",
    "natural_language_projection": "REQUIRED",
    "json_projection": "REQUIRED",
