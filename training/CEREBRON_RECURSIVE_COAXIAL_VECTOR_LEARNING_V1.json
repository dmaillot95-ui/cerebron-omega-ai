  "coaxial_architecture": {
    "central_axis": [
      "CANONICAL_GOLD_RED_LESSONS",
      "PROVENANCE_AND_LINEAGE",
      "FAILURE_BANK",
      "COLD_BENCHMARK_BOUNDARIES",
      "TRANSFER_AND_REDTEAM_RESULTS"
    ],
    "role_residual_axis": "GVL_32D_SPECIALIZATION_VECTOR",
    "vector_registry": "config/gvl-specialization-registry-v2.json",
    "semantic_memory_reference": "F115_VECTOR_SEMANTIC_MEMORY",
    "rule": "Shared central knowledge may teach multiple AIs, but each AI receives role-residual curriculum selected by specialization vector and measured failure modes."
  },
  "recursive_generation_loop": [
    "G_N_BASELINE",
    "PARALLEL_AGORA_ATTEMPTS",
    "AUDIT_COUNTER_AUDIT_REPRODUCTION",
    "DEDUP_AND_DEPENDENCY_FINGERPRINT",
    "GOLD_RED_LESSON_PROMOTION",
    "VECTOR_ROUTE_TO_TARGET_AIS",
    "PROMPT_ROUTER_SELF_EVOLUTION",
    "ROLE_SPECIFIC_DATASET_SEAL",
    "SCRATCH_VS_INHERITED_ABLATION",
    "REAL_ADAPTER_OR_WEIGHT_TRAINING_IF_RELEASED",
    "COLD_NO_RAG",
    "TRANSFER_NO_RAG",
    "RED_TEAM",
    "REGRESSION",
    "PROMOTE_OR_ROLLBACK",
    "FAILURES_TO_NEXT_CURRICULUM",
    "G_N_PLUS_1"
  ],
  "parallel_lanes": [
    {
      "lane": "A_GENERATOR",
      "purpose": "construct solution/hypothesis",
      "independence_requirement": "distinct prompt/role; model lineage recorded"
    },
    {
      "lane": "B_ALTERNATIVE",
      "purpose": "different representation or method",
      "independence_requirement": "prefer distinct model lineage for high-value tasks"
    },
    {
      "lane": "C_FALSIFIER",
      "purpose": "counterexample/red-team",
      "independence_requirement": "must not receive hidden expected answer"
    },
    {
      "lane": "D_REPRODUCER",
      "purpose": "independent reproduction",
      "independence_requirement": "separate execution trace and dependency fingerprint"
    },
    {
      "lane": "E_TRANSFER",
      "purpose": "cross-domain unseen transfer",
      "independence_requirement": "sealed from training data"
    },
    {
      "lane": "F_ABLATION",
      "purpose": "compare adapter vs base/scratch/inherited",
      "independence_requirement": "same benchmark, controlled change only"
    }
  ],
  "agora_learning": {
    "raw_agora_is_training_data": false,
    "admission_chain": [
      "TRACE",
      "AUDIT",
      "COUNTER_AUDIT",
      "REPRODUCTION",
      "GOLD_OR_RED",
      "DATASET_VERSION",
      "TRAINING_RELEASE"
    ],
    "peer_learning": true,
    "failure_to_curriculum": true,
    "contradiction_preserved": true,
    "anti_false_novelty": true
  },
  "training_policy": {
    "default": "REVERSIBLE_LORA_OR_ADAPTER",
    "full_weight_training": "DENY_BY_DEFAULT",
    "parallel_training_max": 4,
    "per_ai_parallel_candidates": 2,
    "minimum_distinct_model_lineages_for_high_value_dual_path": 2,
    "no_paid_provider_auto_activation": true,
    "m6_deny_training": true,
    "memory_is_not_training": true,
    "weights_changed_required_for_training_claim": true,
    "adapter_sha_required": true,
    "base_revision_required": true,
    "dataset_sha_required": true
  },
  "promotion_gate": {
    "required": [
      "WEIGHTS_OR_ADAPTER_CHANGED",
      "ARTIFACT_SHA256",
      "HF_PRIVATE_READBACK_SHA_IF_USED",
      "COLD_GAIN_POSITIVE",
      "TRANSFER_GAIN_POSITIVE",
      "REDTEAM_NOT_WORSE",
      "ABLATION_SUPPORTS_CAUSAL_VALUE",
      "NO_CRITICAL_REGRESSION",
      "DEPENDENCY_FINGERPRINT",
      "FAILURE_BANK_UPDATED",
      "AFAH_OR_EQUIVALENT_FINAL_POLICY_GATE"
    ],
    "otherwise": "ROLLBACK_RETAIN_EVIDENCE"
  },
  "geometric_growth_metric": {
    "name": "SUSTAINED_GEOMETRIC_CAPABILITY_RATIO",
    "definition": "For a fixed sealed benchmark family, compute per-generation post/pre score ratios on COLD, TRANSFER and REDTEAM-survival, then geometric-mean them. Claim sustained geometric improvement only after at least 3 consecutive generations each exceed 1.0 with no critical regression.",
